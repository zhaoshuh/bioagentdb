# 复制为 .env 后填写。
# 说明（L-0208）：本文件只保留**机密与部署级**配置；策略参数（任务限界/调度器/矿机/检索/核验/
# 工作台/collect 等）一律在 `config/bioagentdb.example.toml`（复制为 `config/bioagentdb.toml`）。
# 优先级：进程环境变量 > .env > config/bioagentdb.toml > 代码默认。
# Docker 下同样读取本文件（compose env_file: .env）。

# ---------- 大模型（必填）----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_SCORING_MODEL=deepseek-v4-flash

# ---------- LLM 响应缓存（可选，默认关闭）----------
# 1=开启（把每次请求/响应落盘 data/llm_cache/）
BIOAGENTDB_LLM_CACHE=0

# Agent 实现：deepagents（安装后默认）| legacy（旧实现，回退用）
# BIOAGENTDB_AGENT_IMPL=deepagents

# ---------- 服务（本机跑可保持注释=默认 127.0.0.1:8000、数据 <repo>/data；Docker 由 compose 显式覆盖）----------
# BIOAGENTDB_HOST=127.0.0.1
# BIOAGENTDB_PORT=8000
# 数据目录：默认 <repo>/data（Docker 下 compose 会设为 /app/data）
# BIOAGENTDB_DATA_DIR=
# 数据库位置（默认 <data_dir>/bioagentdb.sqlite3）
# BIOAGENTDB_DB_PATH=
# 只读演示模式（1=写操作全部 403；公网演示建议开启）
# BIOAGENTDB_PUBLIC_DEMO=0

# ---------- NCBI E-utilities（可选，可提升限速）----------
NCBI_EMAIL=
NCBI_API_KEY=

# ---------- 网络代理（可选；Docker 内一般留空，直连优先）----------
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890

# ---------- 挖掘/核验参数 ----------
HARVEST_MAX_PAPERS_PER_RUN=500
HARVEST_CONCURRENCY=6
HARVEST_VERIFY_CONCURRENCY=8
BIOAGENTDB_MIN_CONFIDENCE=0.6
BIOAGENTDB_REQUEST_TIMEOUT=30

# ---------- 多源检索 / 可选服务（L-0215 补齐；均可留空走默认）----------
# 多源补货开关（1=EPMC + OpenAlex/CORE/PubMed/预印本过滤式接入；0=仅 EPMC）
BIOAGENTDB_REFILL_MULTISOURCE=1
# 多源检索钥匙（可选，提升配额/覆盖）
OPENALEX_API_KEY=
OPENALEX_EMAIL=
CORE_API_KEY=
# HTTP User-Agent（合规标识）
BIOAGENTDB_USER_AGENT=BioAgentDB/0.1 (academic data catalog)
# 站点 API 令牌（预留键：尚未接线，设置后暂不影响写接口）
BIOAGENTDB_API_TOKEN=
# 网页检索提供方（auto=自动择优）
BIOAGENTDB_WEB_SEARCH_PROVIDER=auto
# OpenCode Go 网关（可选：视觉审稿模型）
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=
OPENCODE_GO_VISION_MODEL=deepseek-v4-flash-vision-exp
